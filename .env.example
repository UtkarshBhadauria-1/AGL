# Organizer write-protection key. Use a long random value in production.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ADMIN_KEY=replace-with-a-long-random-secret

# Express server port (defaults to 5000).
PORT=5000

# Frontend origin embedded in every participant QR code.
VITE_APP_URL=http://localhost:5173
# Production example: VITE_APP_URL=https://<production-domain>

# Comma-separated exact frontend origins when hosting frontend and backend separately.
# CORS_ORIGIN=https://voting.example.com

# Public API base URL for a separately hosted frontend. Leave unset for same-origin/dev proxy.
# VITE_API_URL=https://voting-api.example.com

# Vite dev proxy target (defaults to http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000

# Optional persistent volume path; defaults to ./backend/data.
# DATA_DIR=/var/lib/agl-voting
